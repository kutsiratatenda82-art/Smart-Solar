# Smart Solar Alert Configuration

# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/smart_solar_dev

# Security
# To generate a safe secret key run: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Chatbot (Gemini)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
